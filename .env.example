# Proveedor activo: ollama (local, exigido por el taller) | vercel (solo comparación)
PROVEEDOR=ollama

# Ollama (local)
MODELO_OLLAMA=llama3.2:3b

# Vercel AI Gateway (opcional; la clave NUNCA se sube al repositorio)
AI_GATEWAY_API_KEY=
MODELO_VERCEL=
# Modelos de respaldo, separados por coma
MODELOS_RESPALDO=

# Puerto de la API
PORT=3000

# Repositorio de datos: mongo (Atlas) | memoria (pruebas y respaldo sin red)
REPOSITORIO=mongo
# Cadena de conexión de Atlas. NUNCA se sube. Se copia de Atlas > Connect > Drivers.
MONGODB_URI=
MONGODB_DB=guardian_labs
MONGODB_DB_PRUEBAS=guardian_labs_test
