# Proveedor activo: ollama (local, exigido por el taller) | vercel (solo comparación)
PROVEEDOR=ollama

# Ollama (local)
MODELO_OLLAMA=llama3.2:3b

# Vercel AI Gateway (opcional; la clave NUNCA se sube al repositorio)
AI_GATEWAY_API_KEY=
# Modelos gratuitos (etiqueta "free" en https://vercel.com/ai-gateway/models, consulta del 6-11-2026).
# Si uno no responde, cambia MODELO_VERCEL por otro de esta lista y reinicia la API.
# Verifica los IDs con tu clave antes de usarlos: la lista de Vercel cambia con el tiempo.
#   humansand/ampersand-v0.1
#   nvidia/nemotron-3.5-lightning-free
#   stealth/glyph-cluster
MODELO_VERCEL=
# Modelos de respaldo, separados por coma
MODELOS_RESPALDO=

# Puerto de la API
PORT=3000

# Repositorio de datos: mongo (Atlas) | memoria (pruebas y respaldo sin red)
REPOSITORIO=mongo
# MongoDB local con replica set rs0 (ver README, «MongoDB local»). Sin credenciales.
# Para Atlas, reemplaza el valor por la cadena de Atlas > Connect > Drivers (NUNCA se sube).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=guardian_labs
MONGODB_DB_PRUEBAS=guardian_labs_test
